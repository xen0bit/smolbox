{
  "cases": [
    {
      "name": "echo round-trip",
      "steps": [
        {
          "request": {
            "cmd": "echo hello"
          },
          "expect": {
            "exit_code": 0,
            "stdout": "hello\n"
          }
        }
      ]
    },
    {
      "name": "non-zero exit code propagates",
      "steps": [
        {
          "request": {
            "cmd": "exit 3"
          },
          "expect": {
            "exit_code": 3
          }
        }
      ]
    },
    {
      "name": "stdout and stderr stay separated",
      "steps": [
        {
          "request": {
            "cmd": "echo out; echo err >&2"
          },
          "expect": {
            "exit_code": 0,
            "stdout": "out\n",
            "stderr": "err\n"
          }
        }
      ]
    },
    {
      "name": "timeout kills the process group and leaves no orphan",
      "steps": [
        {
          "request": {
            "cmd": "sleep 5",
            "timeout_ms": 500
          },
          "expect": {
            "exit_code": 137,
            "timed_out": true
          }
        },
        {
          "request": {
            "cmd": "grep -l '^sleep$' /proc/[0-9]*/comm"
          },
          "expect": {
            "exit_code": 1,
            "stdout": ""
          }
        }
      ]
    },
    {
      "name": "1 MiB stdout survives intact",
      "steps": [
        {
          "request": {
            "cmd": "head -c 1048576 /dev/zero | tr '\\0' a"
          },
          "expect": {
            "exit_code": 0,
            "stdout_len": 1048576,
            "truncated": false
          }
        }
      ]
    },
    {
      "name": "output past MaxOutput sets Truncated",
      "steps": [
        {
          "request": {
            "cmd": "head -c 100000 /dev/zero | tr '\\0' a",
            "max_output": 1024
          },
          "expect": {
            "exit_code": 0,
            "stdout_len": 1024,
            "truncated": true
          }
        }
      ]
    },
    {
      "name": "a line >4096 bytes round-trips (ICANON guard)",
      "steps": [
        {
          "request": {
            "cmd": "printf ''"
          },
          "expect": {
            "exit_code": 0,
            "stdout": ""
          }
        }
      ]
    },
    {
      "name": "state persists across calls",
      "steps": [
        {
          "request": {
            "cmd": "cd /tmp && touch conformance-mark"
          },
          "expect": {
            "exit_code": 0
          }
        },
        {
          "request": {
            "cmd": "test -f /tmp/conformance-mark && echo STATE_OK"
          },
          "expect": {
            "exit_code": 0,
            "stdout": "STATE_OK\n"
          }
        },
        {
          "request": {
            "cmd": "pwd"
          },
          "expect": {
            "exit_code": 0,
            "stdout": "/tmp\n"
          }
        }
      ]
    },
    {
      "name": "mount: read a file through the host mount",
      "requires": [
        "mount"
      ],
      "steps": [
        {
          "request": {
            "cmd": "cat /mnt/host/hello.txt"
          },
          "expect": {
            "exit_code": 0,
            "stdout": "hello from the mount\n"
          }
        }
      ]
    },
    {
      "name": "mount: nested subdirectory read",
      "requires": [
        "mount"
      ],
      "steps": [
        {
          "request": {
            "cmd": "cat /mnt/host/sub/nested.txt"
          },
          "expect": {
            "exit_code": 0,
            "stdout": "nested fixture\n"
          }
        }
      ]
    },
    {
      "name": "mount: directory listing matches the fixture tree",
      "requires": [
        "mount"
      ],
      "steps": [
        {
          "request": {
            "cmd": "ls -1 /mnt/host"
          },
          "expect": {
            "exit_code": 0,
            "stdout": "hello.txt\nlink.txt\nsub\n"
          }
        }
      ]
    },
    {
      "name": "mount: symlink resolves through the mount",
      "requires": [
        "mount"
      ],
      "steps": [
        {
          "request": {
            "cmd": "cat /mnt/host/link.txt"
          },
          "expect": {
            "exit_code": 0,
            "stdout": "hello from the mount\n"
          }
        }
      ]
    },
    {
      "name": "mount: writes are rejected (read-only at the host boundary)",
      "requires": [
        "mount"
      ],
      "steps": [
        {
          "request": {
            "cmd": "echo x > /mnt/host/hello.txt 2>&1; echo rc=$?"
          },
          "expect": {
            "exit_code": 0,
            "stdout": "rc=1\n",
            "stderr_contains": "can't create"
          }
        }
      ]
    },
    {
      "name": "mount: ../ escape above the mount root fails without leaking host files",
      "requires": [
        "mount"
      ],
      "steps": [
        {
          "request": {
            "cmd": "cat /mnt/host/../secret.txt 2>&1; echo rc=$?"
          },
          "expect": {
            "exit_code": 0,
            "stdout_contains": "rc=1",
            "stdout_not_contains": "SMOLBOX-TRAVERSAL-SENTINEL"
          }
        }
      ]
    },
    {
      "name": "search tooling: ripgrep is installed",
      "steps": [
        {
          "request": {
            "cmd": "rg --version | head -1"
          },
          "expect": {
            "exit_code": 0,
            "stdout_contains": "ripgrep"
          }
        }
      ]
    },
    {
      "name": "search tooling: tree is installed",
      "steps": [
        {
          "request": {
            "cmd": "tree --version"
          },
          "expect": {
            "exit_code": 0,
            "stdout_contains": "tree"
          }
        }
      ]
    },
    {
      "name": "search tooling: tree walks the host mount (stats, so d_type does not matter)",
      "requires": [
        "mount"
      ],
      "steps": [
        {
          "request": {
            "cmd": "tree /mnt/host"
          },
          "expect": {
            "exit_code": 0,
            "stdout_contains": "nested.txt"
          }
        }
      ]
    },
    {
      "name": "search tooling: grep -r is the working recursive search on the mount",
      "requires": [
        "mount"
      ],
      "steps": [
        {
          "request": {
            "cmd": "grep -rn nested /mnt/host"
          },
          "expect": {
            "exit_code": 0,
            "stdout_contains": "sub/nested.txt"
          }
        }
      ]
    },
    {
      "name": "search tooling: rg reads an explicit mount file (traversal is a known gap)",
      "requires": [
        "mount"
      ],
      "steps": [
        {
          "request": {
            "cmd": "rg --no-heading -n hello /mnt/host/hello.txt"
          },
          "expect": {
            "exit_code": 0,
            "stdout_contains": "hello from the mount"
          }
        }
      ]
    },
    {
      "name": "mount: KNOWN GAP \u2014 readdir has no d_type, so find does not recurse",
      "requires": [
        "mount"
      ],
      "steps": [
        {
          "request": {
            "cmd": "find /mnt/host -type f | tr '\\n' ' '"
          },
          "expect": {
            "exit_code": 0,
            "stdout_contains": "hello.txt",
            "stdout_not_contains": "nested.txt"
          }
        }
      ]
    },
    {
      "name": "mount: KNOWN GAP \u2014 ls -R lists everything but exits 1, same missing d_type",
      "requires": [
        "mount"
      ],
      "steps": [
        {
          "request": {
            "cmd": "ls -R /mnt/host"
          },
          "expect": {
            "exit_code": 1,
            "stdout_contains": "nested.txt",
            "stderr_contains": "Not a directory"
          }
        }
      ]
    }
  ]
}
