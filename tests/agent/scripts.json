{
  "comment": "Scripted model turns for FakeModelClient, the GPU-free stand-in for the WebGPU model. Each `text` is raw model output, markers and all, so the dialect parser and the loop run exactly as they do against the real thing. The failure cases are the ones M8 actually produced against LFM2 \u2014 a Pythonic call filling in every optional argument, a truncated block, output that blows the budget \u2014 because a loop that has only seen well-formed turns will not survive a real model (PLAN \u00a710.8 risk 17).",
  "scripts": [
    {
      "name": "plain answer, no tool, as LFM2.5 really emits it (the prompt opened <think>)",
      "when": "who are you",
      "turns": [
        {
          "text": "The user is asking who I am.</think>I am smolbox, an assistant with a Linux sandbox."
        }
      ]
    },
    {
      "name": "one tool call, pythonic, as LFM2 really emits it",
      "when": "what files",
      "turns": [
        {
          "text": "<|tool_call_start|>[run_terminal_command(cmd=\"ls -1 /mnt/host\", cwd=\"/mnt/host\", env={}, stdin=\"\", timeout_ms=0, max_output=0)]<|tool_call_end|>"
        },
        {
          "text": "The folder contains hello.txt, link.txt and sub."
        }
      ]
    },
    {
      "name": "one tool call, JSON syntax",
      "when": "json call",
      "turns": [
        {
          "text": "<|tool_call_start|>[{\"name\": \"run_terminal_command\", \"arguments\": {\"cmd\": \"cat /mnt/host/hello.txt\"}}]<|tool_call_end|>"
        },
        {
          "text": "The file says hello."
        }
      ]
    },
    {
      "name": "prose before a call",
      "when": "explain then look",
      "turns": [
        {
          "text": "Let me check the folder first. <|tool_call_start|>[run_terminal_command(cmd=\"ls /mnt/host\")]<|tool_call_end|>"
        },
        {
          "text": "Done looking."
        }
      ]
    },
    {
      "name": "two calls in sequence",
      "when": "two steps",
      "turns": [
        {
          "text": "<|tool_call_start|>[run_terminal_command(cmd=\"pwd\")]<|tool_call_end|>"
        },
        {
          "text": "<|tool_call_start|>[run_terminal_command(cmd=\"echo second\")]<|tool_call_end|>"
        },
        {
          "text": "Both steps ran."
        }
      ]
    },
    {
      "name": "malformed call, then recovery",
      "when": "malformed",
      "turns": [
        {
          "text": "<|tool_call_start|>[run_terminal_command(cmd=)]<|tool_call_end|>"
        },
        {
          "text": "<|tool_call_start|>[run_terminal_command(cmd=\"echo recovered\")]<|tool_call_end|>"
        },
        {
          "text": "I corrected the call."
        }
      ]
    },
    {
      "name": "output far past the budget",
      "when": "big output",
      "turns": [
        {
          "text": "<|tool_call_start|>[run_terminal_command(cmd=\"head -c 200000 /dev/zero | tr '\\\\0' 'x'\")]<|tool_call_end|>"
        },
        {
          "text": "That was a lot of output."
        }
      ]
    },
    {
      "name": "never stops calling",
      "when": "loop forever",
      "turns": [
        {
          "text": "<|tool_call_start|>[run_terminal_command(cmd=\"echo 1\")]<|tool_call_end|>"
        },
        {
          "text": "<|tool_call_start|>[run_terminal_command(cmd=\"echo 2\")]<|tool_call_end|>"
        },
        {
          "text": "<|tool_call_start|>[run_terminal_command(cmd=\"echo 3\")]<|tool_call_end|>"
        },
        {
          "text": "<|tool_call_start|>[run_terminal_command(cmd=\"echo 4\")]<|tool_call_end|>"
        },
        {
          "text": "<|tool_call_start|>[run_terminal_command(cmd=\"echo 5\")]<|tool_call_end|>"
        },
        {
          "text": "<|tool_call_start|>[run_terminal_command(cmd=\"echo 6\")]<|tool_call_end|>"
        }
      ]
    },
    {
      "name": "slow turn, for the stop button",
      "when": "take your time",
      "turns": [
        {
          "text": "This is a deliberately long answer that streams slowly so the stop button has something to interrupt.",
          "delayMs": 4000
        }
      ]
    },
    {
      "name": "a write the mount must refuse",
      "when": "try writing",
      "turns": [
        {
          "text": "<|tool_call_start|>[run_terminal_command(cmd=\"echo nope > /mnt/host/hello.txt\")]<|tool_call_end|>"
        },
        {
          "text": "The mount is read-only, so that failed."
        }
      ]
    },
    {
      "name": "calls a user-defined tool",
      "when": "user tool",
      "turns": [
        {
          "text": "<|tool_call_start|>[find_in_folder(pattern=\"hello\")]<|tool_call_end|>"
        },
        {
          "text": "Found it."
        }
      ]
    },
    {
      "name": "calls a narrow builtin",
      "when": "disabled tool",
      "turns": [
        {
          "text": "<|tool_call_start|>[list_dir(path=\"/mnt/host\")]<|tool_call_end|>"
        },
        {
          "text": "That is the listing."
        }
      ]
    },
    {
      "name": "tries shell injection through a tool argument",
      "when": "injection attempt",
      "turns": [
        {
          "text": "<|tool_call_start|>[echo_it(value=\"hi; echo PWNED\")]<|tool_call_end|>"
        },
        {
          "text": "Echoed."
        }
      ]
    },
    {
      "name": "a reasoning model: scratchpad, a call, then the answer",
      "when": "think first",
      "turns": [
        {
          "text": "The user wants a listing, so I should run ls.</think><|tool_call_start|>[run_terminal_command(cmd=\"ls -1 /mnt/host\")]<|tool_call_end|>"
        },
        {
          "text": "Now I have the listing and can answer.</think>There are three entries."
        }
      ]
    },
    {
      "name": "a reasoning model that never leaves the scratchpad",
      "when": "think forever",
      "turns": [
        {
          "text": "Let me consider what the user is really asking for and whether"
        }
      ]
    }
  ]
}
