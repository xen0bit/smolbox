{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "types": ["@types/bun"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "serve.ts"]
}
