# Copy to .env and fill in. .env is gitignored; this file is not.
#
# HF_TOKEN is used by `make antares-onnx` (PLAN §11.3) to pull the gated
# fdtn-ai/antares-* checkpoints. Needs a token whose account has accepted the
# model card's terms at https://huggingface.co/fdtn-ai/antares-350m — a valid
# token without that acceptance still gets a 403.
HF_TOKEN=
